# Shopify App
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_API_VERSION=2025-04
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_analytics

# Shopify Store Domains
SHOPIFY_DTC_SHOP=emilylex.myshopify.com
SHOPIFY_WHOLESALE_SHOP=elsw.myshopify.com
# Inventory is ONLY pulled from the DTC store (emilylex).
# The wholesale store (elsw) shares the same inventory pool.
# Never add elsw as an inventory source.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (Finaloop)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
FINALOOP_PNL_SHEET_ID=
FINALOOP_BALANCE_SHEET_ID=
FINALOOP_CASHFLOW_SHEET_ID=

# Edge Function env vars (set in Supabase Dashboard, not Vercel)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-provided by Supabase
# FINALOOP_PNL_TAB=Sheet1
# FINALOOP_BS_TAB=Sheet1
# FINALOOP_CF_TAB=Sheet1

# Resend (alerts)
RESEND_API_KEY=

# Anthropic (Phase 5 - AI briefing)
ANTHROPIC_API_KEY=
