# Shopify App
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_URL=
SHOPIFY_API_VERSION=2025-04
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_analytics

# Shopify Store Domains
SHOPIFY_DTC_SHOP=emilylex.myshopify.com
SHOPIFY_WHOLESALE_SHOP=elsw.myshopify.com
# Inventory is ONLY pulled from the DTC store (emilylex).
# The wholesale store (elsw) shares the same inventory pool.
# Never add elsw as an inventory source.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (Finaloop)
# Service account credentials — set in BOTH Vercel AND Supabase Edge Function env vars
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Sheet IDs can be set here as env vars OR entered in Settings > Channels > Data Sources.
# fin_settings values take priority if env vars are empty.
# Can be full URLs (https://docs.google.com/spreadsheets/d/XXXXX/edit) or just the ID.
FINALOOP_PNL_SHEET_ID=
FINALOOP_BALANCE_SHEET_ID=
FINALOOP_CASHFLOW_SHEET_ID=

# Edge Function env vars (set in Supabase Dashboard > Edge Functions > Secrets)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-provided by Supabase
# Tab names default to "Profit & Loss", "Balance Sheet", "Cash Flow"
# Override if your Finaloop sheets use different tab names:
# FINALOOP_PNL_TAB=Profit & Loss
# FINALOOP_BS_TAB=Balance Sheet
# FINALOOP_CF_TAB=Cash Flow

# Resend (alerts)
RESEND_API_KEY=

# Anthropic (Phase 5 - AI briefing)
ANTHROPIC_API_KEY=
